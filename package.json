{
    "name":  "scriora-worker",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "start":  "node dist/server.js",
                    "build":  "tsc",
                    "lint":  "biome check src/",
                    "lint:fix":  "biome check --write src/",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "typecheck":  "tsc --noEmit"
                },
    "dependencies":  {
                         "inngest":  "^4.20.0",
                         "ioredis":  "^6.0.0",
                         "scriora-core":  "workspace:*",
                         "scriora-social":  "workspace:*",
                         "zod":  "^4.6.2"
                     },
    "devDependencies":  {
                            "@biomejs/biome":  "^2.5.13",
                            "@types/node":  "^22.20.2",
                            "tsx":  "^4.23.13",
                            "typescript":  "^7.0.2",
                            "vitest":  "^5.0.0",
                            "@vitest/coverage-v8":  "^5.0.0"
                        },
    "packageManager":  "pnpm@11.21.0"
}
